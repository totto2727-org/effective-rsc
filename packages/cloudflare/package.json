{
  "name": "@effront/cloudflare",
  "version": "0.1.0",
  "description": "Effront Cloudflare Workers Vite integration and typed request context accessors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/effront.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workers": "./src/workers.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.7"
  },
  "devDependencies": {
    "@effront/vite": "workspace:*",
    "effect": "catalog:",
    "effront": "workspace:*",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@effront/vite": "workspace:^",
    "effront": "workspace:^",
    "vite": "*"
  }
}
