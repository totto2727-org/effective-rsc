{
  "name": "effront",
  "version": "0.1.4-workers.0",
  "description": "Effect-native React Server Components with a Web fetch core and Vite/Cloudflare Workers integration.",
  "keywords": [
    "cloudflare-workers",
    "effect",
    "react-server-components"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-server": "./src/index.ts",
      "default": "./src/unsupported.ts"
    },
    "./vite": "./src/vite.ts",
    "./workers": "./src/workers.ts",
    "./cloudflare": "./src/cloudflare.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "catalog:",
    "oxc-transform-react": "^0.145.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@effect/platform-browser": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vite-plugin": {
      "optional": true
    }
  }
}
